# Server Config
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL - Docker / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sclip_db?schema=public"

# Auth / JWT
JWT_SECRET=supersecret_jwt_signing_key_sclip_2026
JWT_EXPIRES_IN=7d

# Storage Configuration (minio or s3)
STORAGE_PROVIDER=minio

# MinIO Config (Local Dev)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=sclip-documents
MINIO_REGION=us-east-1

# AWS S3 Config (Production)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sclip-documents-prod

# Email Service (nodemailer or resend)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="SCLIP Compliance Alert <alerts@sclip.local>"
RESEND_API_KEY=re_123456789

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
