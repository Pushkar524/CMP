# SCLIP Backend Environment Configuration
# Copy this file to .env and fill in actual values before running

# ============================================================
# Server Configuration
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# CRITICAL: Security Settings (NO defaults - must be set!)
# ============================================================
# JWT Secret used for signing authentication tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-must-be-replaced

# JWT Expiration Time
JWT_EXPIRES_IN=7d

# ============================================================
# Database Configuration
# ============================================================
# PostgreSQL connection string
# Example: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sclip

# ============================================================
# Storage Configuration
# ============================================================
# Storage provider: 'minio' or 's3'
STORAGE_PROVIDER=minio

# Minio Configuration (required when STORAGE_PROVIDER=minio)
# These are NOT optional - remove the defaults from env.js if using minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=sclip-documents
MINIO_REGION=us-east-1

# AWS S3 Configuration (required when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sclip-documents-prod

# ============================================================
# Email Configuration
# ============================================================
# Email provider: 'resend' or 'nodemailer'
EMAIL_PROVIDER=nodemailer

# SMTP Configuration (required when using nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=SCLIP <alerts@sclip.local>

# Resend Configuration (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=SCLIP Compliance <onboarding@resend.dev>

# ============================================================
# Frontend Integration
# ============================================================
# Base URL for the backend API (used by frontend)
REACT_APP_API_BASE=http://localhost:5000

# ============================================================
# CORS Configuration
# ============================================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173